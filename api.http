@baseUrl = http://localhost:3000

# Variáveis para reutilização
@token = {{login.response.body.token}}
@userId = {{login.response.body.user.id}}

### Health Check
GET {{baseUrl}}/health HTTP/1.1

###

### ==============================================================================
### ROTAS DE AUTENTICAÇÃO (/auth)
### ==============================================================================

### Login (autenticar usuário e obter token JWT)
# @name login
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "john.doe@email.com",
  "password": "1511"
}

###

### Registro de Usuário (via /auth/register)
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@email.com",
  "cpf": "54962545825",
  "password": "1511"
}

###

### Registro de Usuário (alias /auth/cadastro)
POST {{baseUrl}}/auth/cadastro HTTP/1.1
Content-Type: application/json

{
  "name": "Jane Doe",
  "email": "jane.doe@email.com",
  "cpf": "54962545825",
  "password": "1511"
}

###

### Perfil do Usuário Autenticado (via /auth/me)
GET {{baseUrl}}/auth/me HTTP/1.1
Authorization: Bearer {{token}}

###

### ==============================================================================
### ROTAS DE USUÁRIOS (/users)
### ==============================================================================

### Criar Usuário (via /users)
POST {{baseUrl}}/users HTTP/1.1
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@email.com",
  "cpf": "54962545825",
  "password": "1511"
}

###

### Obter Perfil do Usuário Autenticado (via /users/me)
GET {{baseUrl}}/users/me HTTP/1.1
Authorization: Bearer {{token}}

###

### Listar Usuários (com filtros e paginação opcionais)
GET {{baseUrl}}/users?page=1&limit=10&name=&email= HTTP/1.1
Authorization: Bearer {{token}}

###

### Buscar Usuário por ID
GET {{baseUrl}}/users/{{userId}} HTTP/1.1
Authorization: Bearer {{token}}

###

### Atualizar Usuário por ID (parcial - PATCH)
PATCH {{baseUrl}}/users/{{userId}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "John Doe Atualizado",
  "email": "john.updated@email.com"
}

###

### Deletar Usuário por ID
DELETE {{baseUrl}}/users/{{userId}} HTTP/1.1
Authorization: Bearer {{token}}

###
### ==============================================================================
### LANÇAMENTOS FINANCEIROS (/transactions)
### ================================================================================

@transactionId = {{createTransaction.response.body.id}}
@categoryId = adc3c563-cee5-4680-a356-de96e1b81683
@sourceDestinationId = adc3c563-cee5-4680-a356-de96e1b81683

### Criar lançamento
# @name createTransaction
POST {{baseUrl}}/transactions HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "sourceDestinationId": "{{sourceDestinationId}}",
  "type": "expense",
  "description": "Compra no supermercado",
  "amount": 250.50,
  "transactionDate": "2026-11-16",
  "dueDate": "2026-11-20",
  "status": "pending"
}

### Listar lançamentos com paginação e filtros
GET {{baseUrl}}/transactions?page=1&limit=10&type=expense&status=pending HTTP/1.1
Authorization: Bearer {{token}}

### Listar lançamentos por período e descrição
GET {{baseUrl}}/transactions?startDate=2026-01-01&endDate=2026-12-31&search=mercado&sortBy=amount&sortOrder=DESC HTTP/1.1
Authorization: Bearer {{token}}

### Buscar lançamento por ID
GET {{baseUrl}}/transactions/{{transactionId}} HTTP/1.1
Authorization: Bearer {{token}}

### Atualizar lançamento parcialmente
PATCH {{baseUrl}}/transactions/{{transactionId}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Compra mensal no supermercado",
  "amount": 300.00,
  "status": "paid"
}

### Excluir lançamento logicamente
DELETE {{baseUrl}}/transactions/{{transactionId}} HTTP/1.1
Authorization: Bearer {{token}}
